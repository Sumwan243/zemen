    <!-- Seasons -->
    <string name="season_kiremt">ክረምት</string>
    <string name="season_kiremt_desc">የዝናብ ወቅት. ከሰኔ እስከ መስከረም ድረስ. የኢትዮጵያ ከፍል-ምድሮች በየቀኑ የሚዘነቡ ጥልቅ አስተማማኝ የሰማይ ውሃ ያገኛሉ. ገበሬዎች ዋና ሰብሎቻቸውን ይዘራሉ.</string>
    <string name="season_tsedey">ጅደይ</string>
    <string name="season_tsedey_desc">የማርቆስ ወቅት. ከመስከረም እስከ ታኅሣሥ ድረስ. አካባቢው ወይራማ ቀለም ይወስዳል. ሰብሎች ይበሩ እና የመስቀል ድሮ አበቦች በሰራዊት ላይ ይበቁላሉ.</string>
    <string name="season_bega">በጋ</string>
    <string name="season_bega_desc">የደረቅ ወቅት. ከታኅሣሥ እስከ ሚያዝያ ድረስ. ጽግት ሰማያዊ ሰማይ የከፍል-ምድሮቹን ያጋጥማል. ቲምቃት በዚህ ጊዜ ይከበራል.</string>
    <string name="season_belg">በልግ</string>
    <string name="season_belg_desc">የአቋራጭ ጥልቅስ ወቅት. ከሚያዝያ እስከ ሰኔ ድረስ. የመስቀል ድሮ አበቦች በተራሮች ላይ ይበቁላሉ. አካባቢው በተስፋፊ ማህበረ ሰብ ይተሰማል.</string>
    <string name="season_pagume">ጳጉሜን</string>
    <string name="season_pagume_desc">የ13ኛው ወር. 5 ቀናት ዓመት ከዓመት ወደ ዓመት የሚለውጥ ጊዜ. አገር አቀፍ ትምህርት በአብይ አመት መጨረሻ ላይ.</string>

